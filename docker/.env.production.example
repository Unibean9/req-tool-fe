# Paste this into the Dokploy UI's "Environment" tab for the req-tool-fe app.
# Consumed by docker/docker-compose.prod.yml at container runtime only.
#
# Do NOT put NEXT_PUBLIC_* vars here — they are baked into the image at
# Docker build time (in .github/workflows/docker-publish.yml) and a runtime
# .env file here has no effect on them. To change a NEXT_PUBLIC_* value,
# edit the workflow and rebuild/republish the image instead.

# DockerHub namespace the image is pulled from
DOCKER_USERNAME=your-dockerhub-username

# Image tag to deploy. Defaults to "latest" if unset — pin to a commit SHA
# for production and for rollback (see docker/README.md "Rollback")
IMAGE_TAG=latest

# Memory limit for the container. Defaults to 512m if unset
REQ_TOOL_FE_MEM_LIMIT=512m
