# Build-time env vars for the Docker image (Next.js NEXT_PUBLIC_* — public,
# inlined into the JS bundle at `npm run build`). Loaded by the "publish" job
# in .github/workflows/docker-publish.yml and passed as --build-arg.
#
# Not secret, safe to commit. To change a value, edit it here and push to
# main — the next image build/push will pick it up automatically.
#
# This file has nothing to do with running the container — that's
# docker/docker-compose.prod.yml + docker/.env.production.example on Dokploy.

NEXT_PUBLIC_API_URL=http://api-req.bean9.net/
NEXT_PUBLIC_APP_URL=https://req.bean9.net/
NEXT_PUBLIC_COOKIE_DOMAIN=.bean9.net
NEXT_PUBLIC_ENV=production
NEXT_PUBLIC_POST_LOGIN_PATH=/dashboard
NEXT_PUBLIC_SEO_SUBJECTS_PATH=/subjects
